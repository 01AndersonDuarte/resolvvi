generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Process {
  id              Int        @id @default(autoincrement())
  cnj             String     @unique
  forum           String
  court           String
  lawsuitValue    Decimal
  numberOfAuthors Int
  movements       Movement[]
}

model Movement {
  id              Int      @id @default(autoincrement())
  processId       Int
  movementDate    DateTime @db.Date
  movementTitle   String
  movementContent String?
  sourceOrder     Int
  process         Process  @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, movementDate, sourceOrder])
}
